---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kopf from '../../components/Kopf.astro';
import Fuss from '../../components/Fuss.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog | WordPress Offenbach" description="Tipps und Wissenswertes rund um WordPress, Webdesign, SEO und Wartung für Unternehmen in Offenbach und dem Rhein-Main-Gebiet.">
  {posts.length === 0 && <meta name="robots" content="noindex" slot="head" />}
  <Kopf />
  <main class="blog abschnitt">
    <div class="seite">
      <h1 class="blog__titel">Blog</h1>
      <p class="blog__lede">Tipps zu WordPress, Webdesign, SEO und Wartung aus Offenbach.</p>
      {posts.length === 0 ? (
        <p class="blog__leer">Hier erscheinen bald die ersten Beiträge.</p>
      ) : (
        <ul class="blog__liste">
          {posts.map((post) => (
            <li class="blog__eintrag">
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <a class="blog__mehr" href={`/blog/${post.id}/`}>Weiterlesen →</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
  <Fuss />
</Base>
